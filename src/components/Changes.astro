---
const changes = [
  {
    title: "1 · Semana definitiva",
    body: "Lunes, martes, miércoles y viernes en <b>Smart Fit Éxito La Flora</b>; el jueves, sesión de boxeo en <b>Fight House Granada</b>. El jueves no entrenas nada más: todo se deja en la clase.",
  },
  {
    title: "2 · Todo al servicio del boxeo",
    body: "Cada ejercicio está elegido por evidencia en preparación de boxeadores: <b>potencia de cadera (saltos, hip thrust, push press), rotación (leñador, twists), cuello, agarre y manguito rotador</b>.",
  },
  {
    title: "3 · Cardio de rounds",
    body: "La condición se construye con <b>intervalos que imitan el ring</b>: cuerda y caminadora en bloques de 3 min / 1 min, y sprints en bici el lunes. El examen es cada jueves.",
  },
  {
    title: "4 · Potencia primero",
    body: "Saltos, balón medicinal y push press van <b>al inicio, en fresco</b>. La velocidad es lo primero que muere cuando te fatigas — no la entrenes cansado.",
  },
  {
    title: "5 · Miércoles amable",
    body: "El día previo al boxeo es <b>cardio y core, sin pesas pesadas</b>: llegas al jueves con piernas vivas y hombros frescos para golpear.",
  },
  {
    title: "6 · Fotos reales",
    body: "Cada tarjeta trae la <b>foto del ejercicio</b> (posición inicial y final, alternándose) para que en el gym no haya dudas de qué hacer.",
  },
  {
    title: "7 · Progresión explícita",
    body: "Nada de subir peso al azar. Usa <b>doble progresión</b> y registra peso y reps en cada sesión; en cardio, sube velocidad o rounds cada semana.",
  },
];
---

<section class="wrap" id="cambios">
  <div class="sec-head reveal">
    <h2>Claves de la rutina</h2><span class="tag">y por qué</span>
  </div>
  <div class="changes">
    {
      changes.map((c) => (
        <article class="change reveal">
          <h3>{c.title}</h3>
          <p set:html={c.body} />
        </article>
      ))
    }
  </div>
</section>
