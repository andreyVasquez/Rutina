---
import { hitos, ascenso, corta } from "../../data/plan-valeria";

const rules = [
  {
    n: "01",
    title: "Descanso entre series",
    body: "<b>90 segundos</b> entre series (<b>60 segundos</b> en el bloque de core del martes).",
  },
  {
    n: "02",
    title: "Peso correcto",
    body: "Elige un peso con el que al terminar cada serie queden <b>~2 repeticiones en reserva</b>.",
  },
  {
    n: "03",
    title: "Progresión",
    body: "Cuando se completen <b>todas las series y repeticiones</b> con un peso, súbelo en la siguiente sesión.",
  },
  {
    n: "04",
    title: "Calentamiento y enfriamiento",
    body: "Son <b>obligatorios en todas las sesiones</b>: cada día los trae antes y después de sus tarjetas.",
  },
];
---

<section class="wrap" id="reglas">
  <div class="sec-head reveal">
    <h2>Reglas generales</h2><span class="tag">no negociables</span>
  </div>
  <div class="rules-grid">
    {
      rules.map((r) => (
        <article class="rule reveal">
          <span class="n">{r.n}</span>
          <div>
            <h3>{r.title}</h3>
            <p set:html={r.body} />
          </div>
        </article>
      ))
    }
  </div>
  <div class="callout reveal">
    <h3>Ajustes de fuerza por fase</h3>
    <p>
      <b>Fases 1–3 (Base, Carga y Pico):</b> series según lo escrito, con
      progresión de peso. <b>Fase 4 (Mantener):</b> mantener pesos, sin subir.
    </p>
    <p>
      <b>Fase 5 (Descarga):</b> 2 series por ejercicio · sin step-downs los
      últimos 5 días antes del ascenso (<b>desde el {corta(hitos.sinStepDownsDesde)}</b>) ·
      última sesión de pierna 3 días antes de subir (<b>el {corta(hitos.ultimaPierna)}</b>,
      para el ascenso del {corta(ascenso)}).
    </p>
  </div>
</section>
