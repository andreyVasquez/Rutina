---
import { ascenso, corta } from "../../data/plan-valeria";
---

<section class="hero" id="top">
  <p class="kicker reveal">Valeria · rumbo al Acatenango</p>
  <h1>
    <span class="ghost reveal">Fuerza</span>
    <span class="hit reveal">+ Montaña<em>.</em></span>
  </h1>
  <p class="sub reveal">
    Preparación para subir el <strong>volcán Acatenango</strong>: unos
    <strong>1.500 m de desnivel el primer día</strong> con mochila de
    <strong>6–10 kg</strong>, campamento a <strong>~3.600 m</strong> y una
    bajada exigente para las rodillas. Smart Fit, 5 días por semana, sesiones
    de máximo 1,5 h — y la postura, que se queda como objetivo.
  </p>
  <div class="chips reveal">
    <span class="chip">Ascenso · <b>{corta(ascenso)} {ascenso.getUTCFullYear()}</b></span>
    <span class="chip" data-hoy="resumen">Semana — · Fase —</span>
    <span class="chip">Máx. <b>1,5 h</b> por sesión</span>
    <span class="chip">Calentamiento y enfriamiento <b>obligatorios</b></span>
  </div>
</section>
