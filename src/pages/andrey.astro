---
import Layout from "../layouts/Layout.astro";
import IconSprite from "../components/IconSprite.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/andrey/Hero.astro";
import Changes from "../components/andrey/Changes.astro";
import Rules from "../components/andrey/Rules.astro";
import Day from "../components/Day.astro";
import ExerciseModal from "../components/ExerciseModal.astro";
import WeightModal from "../components/WeightModal.astro";
import Supplements from "../components/andrey/Supplements.astro";
import Footer from "../components/andrey/Footer.astro";
import { days, altCatalog } from "../data/rutina-andrey";

const links = [
  { href: "#reglas", label: "Reglas" },
  { href: "#dia1", label: "Lun" },
  { href: "#dia2", label: "Mar" },
  { href: "#dia3", label: "Mié" },
  { href: "#dia4", label: "Jue" },
  { href: "#dia5", label: "Vie" },
  { href: "#dia6", label: "Finde" },
  { href: "#suplementos", label: "Suplementos" },
];
---

<Layout profile="andrey">
  <IconSprite />
  <Nav profile="andrey" links={links} />
  <Hero />
  <Changes />
  <Rules />
  {days.map((day) => <Day day={day} altCatalog={altCatalog} />)}
  <ExerciseModal altCatalog={altCatalog} />
  <WeightModal />
  <Supplements />
  <Footer />
</Layout>
