---
import Layout from "../layouts/Layout.astro";
import IconSprite from "../components/IconSprite.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/valeria/Hero.astro";
import Changes from "../components/valeria/Changes.astro";
import Rules from "../components/valeria/Rules.astro";
import Day from "../components/Day.astro";
import ExerciseModal from "../components/ExerciseModal.astro";
import WeightModal from "../components/WeightModal.astro";
import Cooldown from "../components/valeria/Cooldown.astro";
import Footer from "../components/valeria/Footer.astro";
import { days, altCatalog } from "../data/rutina-valeria";

const links = [
  { href: "#reglas", label: "Reglas" },
  { href: "#dia1", label: "Lun" },
  { href: "#dia2", label: "Mar" },
  { href: "#dia3", label: "Mié" },
  { href: "#dia4", label: "Jue" },
  { href: "#dia5", label: "Vie" },
  { href: "#dia6", label: "Sáb" },
  { href: "#dia7", label: "Dom" },
  { href: "#estiramiento", label: "Estirar" },
];
---

<Layout profile="valeria">
  <IconSprite />
  <Nav profile="valeria" links={links} />
  <Hero />
  <Changes />
  <Rules />
  {days.map((day) => <Day day={day} altCatalog={altCatalog} />)}
  <ExerciseModal altCatalog={altCatalog} />
  <WeightModal />
  <Cooldown />
  <Footer />
</Layout>
